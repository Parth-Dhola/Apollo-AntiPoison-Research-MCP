# ── Apollo MCP Server Environment Variables ────────────────────────────────
# 100% of core functionality is FREE and requires zero API keys.

# Optional: Higher GitHub API rate limits (public rate limit: 60 req/hr; with token: 5000 req/hr)
GITHUB_TOKEN=

# Optional: Semantic Scholar API Key for high-volume batch calls (free tier public access is active by default)
SEMANTIC_SCHOLAR_API_KEY=

# Server Transport: "stdio" (for Claude Desktop / Cursor / Antigravity) or "sse" (for HTTP microservice / Docker)
APOLLO_TRANSPORT=stdio
APOLLO_HOST=0.0.0.0
APOLLO_PORT=8080

# Cache Settings
CACHE_DIR=.apollo_cache
CACHE_TTL_SECONDS=86400

# Reranking / RAG Settings
MAX_CANDIDATE_SNIPPETS=15
TOP_K_GROUNDED_SNIPPETS=3
RERANKER_MODEL=ms-marco-TinyBERT-L-2-v2

# Anti-Poisoning & Guardrails
ENABLE_PROMPT_INJECTION_FILTER=true
ENABLE_LATEX_NORMALIZATION=true
ENABLE_NOISE_REDUCTION=true
MAX_SNIPPET_LENGTH=1200

